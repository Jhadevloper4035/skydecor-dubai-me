9:["$","section","How we use your information",{"className":"sd-legal-content__item","children":[["$","h5",null,{"className":"sd-legal-content__title","children":"How we use your information"}],["$","p",null,{"children":"We use personal data to respond to questions and product inquiries, prepare quotations or provide requested information, review and respond to job applications, operate and protect the website, prevent misuse, and meet applicable legal obligations. We do not use inquiry details for unrelated marketing unless permitted by law and, where required, you have agreed."}]]}]
a:["$","section","Legal grounds for processing",{"className":"sd-legal-content__item","children":[["$","h5",null,{"className":"sd-legal-content__title","children":"Legal grounds for processing"}],["$","p",null,{"children":"We process personal data when you have given consent or when processing is otherwise permitted or required by applicable UAE law, such as to respond to a request you make, take steps at your request before entering a contract, perform a contract, meet a legal obligation, or on another ground recognized by law. Where processing is based on consent, you may withdraw it; withdrawal does not affect processing that took place before withdrawal or processing allowed on another legal ground."}]]}]
b:["$","section","Sharing and international transfers",{"className":"sd-legal-content__item","children":[["$","h5",null,{"className":"sd-legal-content__title","children":"Sharing and international transfers"}],["$","p",null,{"children":"We may share relevant information with our authorized personnel, service providers supporting website hosting, storage, communications or operations, and professional advisers. We may also disclose information when required by law or to protect legal rights and safety. If personal data is transferred outside the UAE, we will do so only as permitted by applicable UAE law and any required safeguards."}]]}]
c:["$","section","Retention and security",{"className":"sd-legal-content__item","children":[["$","h5",null,{"className":"sd-legal-content__title","children":"Retention and security"}],["$","p",null,{"children":"We keep personal data only for as long as reasonably needed for the purposes described in this policy, to manage our relationship with you, and to meet legal, accounting, or dispute-resolution requirements. Retention time depends on the type of information and purpose; we securely delete or anonymize it when it is no longer needed, where practicable. We use reasonable security measures, but no online service or storage method can be guaranteed completely secure."}]]}]
d:["$","section","Browser storage and third-party services",{"className":"sd-legal-content__item","children":[["$","h5",null,{"className":"sd-legal-content__title","children":"Browser storage and third-party services"}],["$","p",null,{"children":"Some website features may use browser storage, for example to remember recently viewed products. The website may also link to or embed third-party services such as maps or social platforms. Those providers may collect information under their own privacy notices, which we do not control. You can manage browser storage and cookie settings through your browser."}]]}]
e:["$","section","Your privacy rights",{"className":"sd-legal-content__item","children":[["$","h5",null,{"className":"sd-legal-content__title","children":"Your privacy rights"}],["$","p",null,{"children":"Subject to applicable law, you may have the right to request access to or correction or deletion of your personal data, object to or request restriction of certain processing, and withdraw consent where consent is the basis for processing. You may also raise a concern with the competent UAE authority. To make a request, contact us using the details below. We may need to verify your identity before responding."}]]}]
f:["$","section","Children",{"className":"sd-legal-content__item","children":[["$","h5",null,{"className":"sd-legal-content__title","children":"Children"}],["$","p",null,{"children":"This website is intended for business and general audiences and is not designed to collect personal data from children. If you believe a child has provided personal data to us, please contact us so we can review the request."}]]}]
10:["$","section","Changes and contact",{"className":"sd-legal-content__item","children":[["$","h5",null,{"className":"sd-legal-content__title","children":"Changes and contact"}],["$","p",null,{"children":"We may update this policy when our practices or legal requirements change. The latest version and its update date will be shown on this page. For privacy questions or requests, email info@skydecor.me."}]]}]

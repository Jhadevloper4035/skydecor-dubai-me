    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/shop-default-grid/:path*",
      "destination": "/products/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)/shop-default-grid(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/shop-default-grid",
      "destination": "/products",
      "statusCode": 308,
      "regex": "^(?!/_next)/shop-default-grid(?:/)?$"
    },
    {
      "source": "/contact-02",
      "destination": "/contact",
      "statusCode": 308,
      "regex": "^(?!/_next)/contact-02(?:/)?$"
    },
    {
      "source": "/store-list/:path*",
